# Public site URL, used for SEO (metadata, sitemap, robots.txt, JSON-LD).
# Update this once the custom domain is live.
NEXT_PUBLIC_SITE_URL=https://markowstudios.com

# Gmail account the contact form sends from/to.
# EMAIL_PASSWORD must be a Gmail *App Password* (16 characters, no symbols),
# not the account's normal login password. Generate one at:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
EMAIL_USER=markowstudios@gmail.com
EMAIL_PASSWORD=
EMAIL_CC=
